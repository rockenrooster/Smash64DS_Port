 }
 #endif /* NDS_R2_POSITION_PROBE */
 
+/* -------------------------------------------------------------------------
+ * 60 Hz source -> 30 Hz presentation attachment latch.
+ *
+ * The gameplay origin stays BattleShip's exact joint-17 {60,0,0} point. The
+ * fixed-two scheduler can, however, spawn it during hidden substep 0 and then
+ * advance Fox through substep 1 before the DS presents anything. On c138 the
+ * natural first shot did exactly that: spawn at sub=0, then the first visible
+ * gun/beam frame after logic had advanced by two ticks. The beam's Y/Z remained
+ * bit-for-bit at the source spawn while joint 17 had moved ~58 world Y, which is
+ * the owner's visible detached muzzle.
+ *
+ * Do NOT move the weapon or its attack collision. Instead, derive one constant
+ * presentation delta on the first visible draw from the CURRENT source joint-17
+ * muzzle minus the original source spawn. Applying that same delta to the
+ * rendered beam preserves its source velocity/shape and merely resamples the
+ * hidden 60 Hz attachment event onto the first 30 Hz frame. group_id makes GObj
+ * reuse safe; the fixed ring is larger than the P1 blaster live set and is reset
+ * with the other baked weapon presentation state each match. */
+#define NDS_FOX_BLASTER_PRESENTATION_LATCHES 16u
+typedef struct NDSFoxBlasterPresentationLatch
+{
+    GObj *weapon_gobj;
+    GObj *owner_gobj;
+    u32 group_id;
+    Vec3f source_spawn;
+    Vec3f delta;
+    sb32 delta_ready;
+} NDSFoxBlasterPresentationLatch;
+
+static NDSFoxBlasterPresentationLatch
+    sNdsFoxBlasterPresentation[NDS_FOX_BLASTER_PRESENTATION_LATCHES];
+static u32 sNdsFoxBlasterPresentationNext;
+
+void ndsFoxBlasterResetPresentationLatches(void)
+{
+    memset(sNdsFoxBlasterPresentation, 0, sizeof(sNdsFoxBlasterPresentation));
+    sNdsFoxBlasterPresentationNext = 0u;
+}
+
+sb32 ndsFoxBlasterGetCurrentMuzzle(GObj *fighter_gobj, Vec3f *pos)
+{
+    FTStruct *fp = (fighter_gobj != NULL) ? ftGetStruct(fighter_gobj) : NULL;
+
+    if ((pos == NULL) || (fp == NULL) ||
+        (fp->fkind != nFTKindFox) ||
+        (fp->joints[FTFOX_BLASTER_HOLD_JOINT] == NULL))
+    {
+        return FALSE;
+    }
+    pos->x = FTFOX_BLASTER_SPAWN_OFF_X;
+    pos->y = 0.0F;
+    pos->z = 0.0F;
+    gmCollisionGetFighterPartsWorldPosition(
+        fp->joints[FTFOX_BLASTER_HOLD_JOINT], pos);
+    return TRUE;
+}
+
+static void ndsFoxBlasterRegisterPresentationLatch(
+    GObj *weapon_gobj, GObj *owner_gobj, const Vec3f *source_spawn)
+{
+    WPStruct *wp = (weapon_gobj != NULL) ? wpGetStruct(weapon_gobj) : NULL;
+    NDSFoxBlasterPresentationLatch *latch;
+
+    if ((wp == NULL) || (owner_gobj == NULL) || (source_spawn == NULL))
+    {
+        return;
+    }
+    latch = &sNdsFoxBlasterPresentation[
+        sNdsFoxBlasterPresentationNext % NDS_FOX_BLASTER_PRESENTATION_LATCHES];
+    sNdsFoxBlasterPresentationNext++;
+    latch->weapon_gobj = weapon_gobj;
+    latch->owner_gobj = owner_gobj;
+    latch->group_id = wp->group_id;
+    latch->source_spawn = *source_spawn;
+    latch->delta.x = latch->delta.y = latch->delta.z = 0.0F;
+    latch->delta_ready = FALSE;
+}
+
+sb32 ndsFoxBlasterGetPresentationPosition(GObj *weapon_gobj,
+                                          const Vec3f *source_pos,
+                                          Vec3f *draw_pos)
+{
+    WPStruct *wp = (weapon_gobj != NULL) ? wpGetStruct(weapon_gobj) : NULL;
+    u32 index;
+
+    if ((wp == NULL) || (source_pos == NULL) || (draw_pos == NULL))
+    {
+        return FALSE;
+    }
+    for (index = 0u; index < NDS_FOX_BLASTER_PRESENTATION_LATCHES; index++)
+    {
+        NDSFoxBlasterPresentationLatch *latch =
+            &sNdsFoxBlasterPresentation[index];
+
+        if ((latch->weapon_gobj == weapon_gobj) &&
+            (latch->group_id == wp->group_id) &&
+            (latch->owner_gobj == wp->owner_gobj))
+        {
+            if (latch->delta_ready == FALSE)
+            {
+                Vec3f muzzle;
+
+                if (ndsFoxBlasterGetCurrentMuzzle(latch->owner_gobj,
+                                                  &muzzle) == FALSE)
+                {
+                    return FALSE;
+                }
+                latch->delta.x = muzzle.x - latch->source_spawn.x;
+                latch->delta.y = muzzle.y - latch->source_spawn.y;
+                latch->delta.z = muzzle.z - latch->source_spawn.z;
+                latch->delta_ready = TRUE;
+            }
+            draw_pos->x = source_pos->x + latch->delta.x;
+            draw_pos->y = source_pos->y + latch->delta.y;
+            draw_pos->z = source_pos->z + latch->delta.z;
+            return TRUE;
+        }
+    }
+    return FALSE;
+}
+
 GObj *wpFoxBlasterMakeWeapon(GObj *fighter_gobj, Vec3f *pos)
 {
     GObj *weapon_gobj;
@@ -198,10 +320,14 @@ GObj *wpFoxBlasterMakeWeapon(GObj *fighter_gobj, Vec3f *pos)
 #if NDS_R2_POSITION_PROBE
     ndsFoxBlasterProbeSpawn(fighter_gobj, pos);
 #endif
+    ndsParticleSetFoxBlasterGlowSpawnOwner(fighter_gobj);
     weapon_gobj = battleship_wpFoxBlasterMakeWeapon(fighter_gobj, pos);
+    ndsParticleSetFoxBlasterGlowSpawnOwner(NULL);
     if (weapon_gobj != NULL)
     {
         weapon_gobj->proc_display = ndsFoxBlasterProcDisplay;
+        ndsFoxBlasterRegisterPresentationLatch(
+            weapon_gobj, fighter_gobj, pos);
         gNdsFighterProjectileProofSpawnSuccessCount++;
     }
     return weapon_gobj;
