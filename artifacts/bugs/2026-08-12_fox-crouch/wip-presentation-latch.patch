--- a/include/nds/nds_effects.h
+++ b/include/nds/nds_effects.h
@@ -73,6 +73,18 @@ extern volatile u32 gNdsFoxBlasterQuadFallbackCount;
  * the source position and nine visible sizes, but owns no LBParticle: its
  * 16x8 PAL16 half-disc is mirrored by the DS texture unit into one quad. */
 sb32 ndsParticleSpawnFoxBlasterGlowAOT(const Vec3f *pos);
+/* The battle runs two unchanged 60 Hz source ticks per 30 Hz present. Fox can
+ * fire on hidden substep 0, so his source-exact beam/glow origin belongs to the
+ * previous pose when the first DS frame is finally shown. These helpers own the
+ * PRESENTATION latch only: gameplay weapon/collision positions are untouched.
+ * The latch is source-derived from joint 17 local {60,0,0}; no visual offset is
+ * stored as data. */
+void ndsParticleSetFoxBlasterGlowSpawnOwner(GObj *fighter_gobj);
+sb32 ndsFoxBlasterGetCurrentMuzzle(GObj *fighter_gobj, Vec3f *pos);
+sb32 ndsFoxBlasterGetPresentationPosition(GObj *weapon_gobj,
+                                          const Vec3f *source_pos,
+                                          Vec3f *draw_pos);
+void ndsFoxBlasterResetPresentationLatches(void);
 extern volatile u32 gNdsFoxBlasterGlowAOTSpawnCount;
 extern volatile u32 gNdsFoxBlasterGlowAOTDrawCount;
 extern volatile u32 gNdsFoxBlasterGlowAOTFallbackCount;
