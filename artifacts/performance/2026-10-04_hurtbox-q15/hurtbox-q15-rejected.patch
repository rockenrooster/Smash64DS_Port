+static inline int16_t ndsP2HbQ15FromQ30(int64_t q30)
+{
+    int64_t v = (q30 + (1 << 14)) >> 15;
+
+    if (v > 32767)
+    {
+        v = 32767;
+    }
+    if (v < -32767)
+    {
+        v = -32767;
+    }
+    return (int16_t)v;
+}
+
+/* Q26 x Q15 -> the top 32 bits of the 48-bit product (Q25), and the same
+ * accumulated: SMULWB / SMLAWB (ARM state, ARMv5TE). */
+static inline int32_t ndsP2HbMulWB(int32_t a, int32_t b)
+{
+#if defined(__arm__) && !defined(__thumb__)
+    int32_t r;
+
+    __asm__("smulwb %0, %1, %2" : "=r"(r) : "r"(a), "r"(b));
+    return r;
+#else
+    return (int32_t)(((int64_t)a * (int16_t)b) >> 16);
+#endif
+}
+
+static inline int32_t ndsP2HbMlaWB(int32_t a, int32_t b, int32_t acc)
+{
+#if defined(__arm__) && !defined(__thumb__)
+    int32_t r;
+
+    __asm__("smlawb %0, %1, %2, %3" : "=r"(r) : "r"(a), "r"(b), "r"(acc));
+    return r;
+#else
+    return acc + (int32_t)(((int64_t)a * (int16_t)b) >> 16);
+#endif
+}
