+/* dst = rhs x lhs as ndsR2CfxCompose forms it (the child's local times the
+ * parent's world), with the Q15 local. |lhs| <= NDS_R2_CFX_ROT_MAX = 2^28 and
+ * |rhs| < 2^15 bound each Q25 product by 2^27 and their sum by 3 x 2^27, so
+ * nothing overflows before the range test. Reads lhs into a temp before
+ * writing dst, as the Q26 compose does. */
+static int __attribute__((noinline))
+ndsP2HbCompose15(NDSR2CfxMtx *dst, const NDSR2CfxMtx *lhs,
+                 const NDSP2HbLocal15 *rhs)
+{
+    NDSR2CfxMtx out;
+    u32 row;
+    u32 col;
+
+    for (row = 0u; row < 3u; row++)
+    {
+        const int32_t b0 = rhs->r[row][0];
+        const int32_t b1 = rhs->r[row][1];
+        const int32_t b2 = rhs->r[row][2];
+
+        for (col = 0u; col < 3u; col++)
+        {
+            int32_t acc = ndsP2HbMulWB(lhs->r[0][col], b0);
+
+            acc = ndsP2HbMlaWB(lhs->r[1][col], b1, acc);
+            acc = ndsP2HbMlaWB(lhs->r[2][col], b2, acc);
+            if ((acc > (NDS_R2_CFX_ROT_MAX >> 1)) ||
+                (acc < -(NDS_R2_CFX_ROT_MAX >> 1)))
+            {
+                return 0;
+            }
+            out.r[row][col] = acc * 2;
+        }
+    }
+    for (col = 0u; col < 3u; col++)
+    {
+        /* Q26 x Q12 -> Q38, reduced to Q12, then the parent offset. */
+        int64_t cell = ndsR2CfxShr((int64_t)lhs->r[0][col] * rhs->t[0] +
+                                       (int64_t)lhs->r[1][col] * rhs->t[1] +
+                                       (int64_t)lhs->r[2][col] * rhs->t[2],
+                                   NDS_R2_CFX_ROT_BITS) +
+                       (int64_t)lhs->t[col];
+
+        if ((cell >= (int64_t)NDS_R2_CFX_POS_MAX) ||
+            (cell <= -(int64_t)NDS_R2_CFX_POS_MAX))
+        {
+            return 0;
+        }
+        out.t[col] = (int32_t)cell;
+    }
+    *dst = out;
+    return 1;
+}
