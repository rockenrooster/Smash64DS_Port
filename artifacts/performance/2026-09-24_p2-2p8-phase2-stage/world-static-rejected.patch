+"""Execute the production preorder world pass against independent parent chains."""
+from pathlib import Path
+import shutil
+import subprocess
+import sys
+
+ROOT = Path(__file__).resolve().parents[2]
+sys.path.insert(0, str(ROOT / 'scripts/menus'))
+from source_test_helpers import function
+
+
+def test_preorder_worlds_match_chains_and_reject_bad_topology(tmp_path):
+    source = (ROOT / 'src/port/renderer_adapter_stage.c').read_text()
+    body = function(source, 'ndsRendererAdapterPrepareStageWorlds')
+    program = r'''
+#include <stdint.h>
+#include <assert.h>
+#include <string.h>
+typedef uint8_t u8; typedef uint16_t u16; typedef uint32_t u32; typedef uint64_t u64;
+typedef int sb32;
+#define TRUE 1
+#define FALSE 0
+#define NDS_RENDERER_ADAPTER_DOBJ_PARENT_MAX 8u
+#define NDS_RENDERER_ADAPTER_STAGE_DOBJ_COUNT 32u
+typedef struct { int32_t m[4][4]; } NDSRendererMatrix20p12;
+typedef struct { NDSRendererMatrix20p12 local; u32 index; } DObj;
+typedef struct { u16 parent_index; u8 depth; } NDSRendererNativeStageDObj;
+typedef struct { int unused; } CObj;
+typedef struct { int unused; } NDSRendererAdapterStageFrameCamera;
+typedef struct {
+    u32 dobj_count,binding_count;
+    DObj *dobjs[32], *binding_dobjs[32];
+    NDSRendererNativeStageDObj live_dobjs[32];
+    u64 task36_runtime_rigid_mask;
+    u64 static_world_mask;
+    NDSRendererMatrix20p12 binding_world[32];
+} NDSRendererAdapterNativeStageWorkspace;
+static u32 gNdsStageWorldFlatFrames,gNdsStageWorldFlatNodes,gNdsStageWorldFlatBindings;
+static u32 builds[32],draws[32];
+static NDSRendererMatrix20p12 outputs[32];
+static void ndsRendererAdapterMtxIdentity20p12(NDSRendererMatrix20p12 *m) {
+    memset(m,0,sizeof(*m)); for(int i=0;i<4;i++) m->m[i][i]=4096;
+}
+static int ndsRendererAdapterBuildDObjLocalMatrix(DObj *d,NDSRendererMatrix20p12 *m) {
+    builds[d->index]++; *m=d->local; return TRUE;
+}
+/* Noncommuting affine products with per-level truncation catch reordered or
+ * reassociated parent composition; the reference walks each chain separately. */
+static void ndsRendererMtxMulAffine20p12(const NDSRendererMatrix20p12 *a,
+ const NDSRendererMatrix20p12 *b,NDSRendererMatrix20p12 *out) {
+    NDSRendererMatrix20p12 t={0};
+    for(int r=0;r<4;r++) for(int c=0;c<4;c++) {
+        int64_t v=0; for(int k=0;k<4;k++) v+=(int64_t)a->m[r][k]*b->m[k][c];
+        t.m[r][c]=(int32_t)(v>>12);
+    } *out=t;
+}
+static int ndsRendererAdapterPrepareNativeStageBindingMatrix(CObj *c,
+ NDSRendererAdapterNativeStageWorkspace *w,u32 b,NDSRendererAdapterStageFrameCamera *cam,
+ const NDSRendererMatrix20p12 *world) { draws[b]++; outputs[b]=*world; return TRUE; }
+''' + body + r'''
+int main(void) {
+    /* Two roots, siblings after deep subtrees, and two heads on one DObj. */
+    const u16 parent[]={65535,0,1,1,0,4,65535,6,7,6};
+    const u8 depth[]={0,1,2,2,1,2,0,1,2,1};
+    const u8 map[]={0,2,3,3,5,8,9};
+    DObj d[10]; NDSRendererAdapterNativeStageWorkspace w={0};
+    CObj c={0}; NDSRendererAdapterStageFrameCamera cam={0};
+    w.dobj_count=10; w.binding_count=7;
+    for(int i=0;i<10;i++) {
+        d[i].index=i; ndsRendererAdapterMtxIdentity20p12(&d[i].local);
+        d[i].local.m[0][0]+=i*31; d[i].local.m[0][1]=i*47;
+        d[i].local.m[1][0]=-i*13; d[i].local.m[3][0]=i*1003-77;
+        d[i].local.m[3][1]=i*731+17;
+        w.dobjs[i]=&d[i]; w.live_dobjs[i]=(NDSRendererNativeStageDObj){parent[i],depth[i]};
+    }
+    for(int i=0;i<7;i++) w.binding_dobjs[i]=&d[map[i]];
+    for(u32 mask=0;mask<128;mask++) {
+        w.task36_runtime_rigid_mask=mask; w.static_world_mask=mask;
+        memset(builds,0,sizeof(builds)); memset(draws,0,sizeof(draws));
+        assert(ndsRendererAdapterPrepareStageWorlds(&c,&w,&cam));
+        u8 required[10]={0};
+        for(int b=0;b<7;b++) {
+            if(mask & (1u<<b)) { assert(draws[b]==0); continue; }
+            u16 chain[10]; u32 n=0; u16 i=map[b];
+            while(i!=65535) { chain[n++]=i; required[i]=1; i=parent[i]; }
+            NDSRendererMatrix20p12 ref; ndsRendererAdapterMtxIdentity20p12(&ref);
+            while(n) { i=chain[--n]; ndsRendererMtxMulAffine20p12(&d[i].local,&ref,&ref); }
+            assert(draws[b]==1 && memcmp(&ref,&outputs[b],sizeof(ref))==0);
+        }
+        for(int i=0;i<10;i++) assert(builds[i]==required[i]);
+        /* A live source change must be visible on the very next frame. */
+        d[1].local.m[3][0]+=333;
+    }
+    /* Static affine worlds still need camera-dependent binding preparation. */
+    w.task36_runtime_rigid_mask=0; w.static_world_mask=127;
+    for(int b=0;b<7;b++) {
+        ndsRendererAdapterMtxIdentity20p12(&w.binding_world[b]);
+        w.binding_world[b].m[3][0]=10000+b;
+    }
+    memset(builds,0,sizeof(builds)); memset(draws,0,sizeof(draws));
+    assert(ndsRendererAdapterPrepareStageWorlds(&c,&w,&cam));
+    for(int b=0;b<7;b++) assert(draws[b]==1 && outputs[b].m[3][0]==10000+b);
+    for(int i=0;i<10;i++) assert(builds[i]==0);
+    w.static_world_mask=0;
+    w.task36_runtime_rigid_mask=0;
+    w.live_dobjs[0].depth=1; assert(!ndsRendererAdapterPrepareStageWorlds(&c,&w,&cam)); w.live_dobjs[0].depth=0;
+    w.live_dobjs[2].parent_index=2; assert(!ndsRendererAdapterPrepareStageWorlds(&c,&w,&cam)); w.live_dobjs[2].parent_index=1;
+    w.live_dobjs[1].depth=3; assert(!ndsRendererAdapterPrepareStageWorlds(&c,&w,&cam)); w.live_dobjs[1].depth=1;
+    w.live_dobjs[5].parent_index=1; assert(!ndsRendererAdapterPrepareStageWorlds(&c,&w,&cam)); w.live_dobjs[5].parent_index=4;
+    w.binding_dobjs[0]=&d[8]; assert(!ndsRendererAdapterPrepareStageWorlds(&c,&w,&cam));
+    w.dobj_count=33; assert(!ndsRendererAdapterPrepareStageWorlds(&c,&w,&cam));
+}
+'''
+    path = tmp_path / 'world_pass.c'
+    binary = path.with_suffix('.exe')
+    path.write_text(program)
+    built = subprocess.run([shutil.which('gcc'), '-std=c11', '-O2', str(path), '-o', str(binary)], capture_output=True, text=True)
+    assert built.returncode == 0, built.stderr
+    run = subprocess.run([str(binary)], capture_output=True, text=True)
+    assert run.returncode == 0, run.stderr
