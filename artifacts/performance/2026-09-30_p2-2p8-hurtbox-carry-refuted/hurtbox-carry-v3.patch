+/* P2-2p8, 2026-09-30: a world carried forward instead of rebuilt.
+ *
+ * An epoch retires every cached world, but most of a fighter's worlds come
+ * back as the same matrices: body joints are posed only on the last source
+ * tick of a presented frame (NDS_FT_POSE_HOLD), so on the other tick their
+ * TRS is the previous tick's, and the root chain mostly just moves. On the
+ * gate a world build (BuildLocal + Compose + walk) was ~2,500 cycles, 10,600 a
+ * match, about two thirds of the kernel.
+ *
+ * ndsR2CfxCompose's rotation rows read only the parent's rotation and the
+ * local's, and BuildLocal derives the local's rotation from the rotate and
+ * scale bits alone; its translation row is
+ *   W.t[c] = Shr(sum_k P.r[k][c] * L.t[k]) + P.t[c].
+ * So when the joint's rotate and scale bits and the parent's rotation are the
+ * ones the slot was built from, W.r is unchanged and W.t moves by exactly the
+ * parent's translation change -- or, when the joint's own translate bits
+ * changed, is that one row recomputed. Either way the value is the full
+ * build's bit for bit, and so is every guard outcome: the unchanged parts
+ * passed their guards at the build, and the recomputed parts are checked with
+ * the build's own conditions. A parent's rotation is named by a stamp that
+ * only a full build renews, so equal stamps mean an equal rotation. A local
+ * taken from the cached float local (transform_update_mode, ndsR2CfxLoadF32)
+ * is keyed the same way on that matrix's rotation and translation cells -- a
+ * third of the tested joints are such locals, and rebuilding them renewed
+ * every descendant's stamp. A parent taken from a latched float world carries
+ * no stamp, so its children are always rebuilt.
+ *
+ * Same-ROM A/B word gNdsP2HbCarry: 0 always rebuilds; 2 carries AND rebuilds,
+ * counts any difference in gNdsP2HbCarryMismatches and keeps the rebuilt
+ * world. */
+#define NDS_P2_HB_STAMP_ROOT 0xFFFFFFFFu
+
+volatile u32 gNdsP2HbCarry __attribute__((used, section(".data"))) = 1u;
+__attribute__((used)) volatile u32 gNdsP2HbCarries;
+__attribute__((used)) volatile u32 gNdsP2HbCarryRows;
+__attribute__((used)) volatile u32 gNdsP2HbBuilds;
+__attribute__((used)) volatile u32 gNdsP2HbCarryMismatches;
+static u32 sNdsP2HbStampNext;
+
+static u32 ndsP2HbNewStamp(void)
+{
+    u32 stamp = sNdsP2HbStampNext + 1u;
+
+    if ((stamp == 0u) || (stamp == NDS_P2_HB_STAMP_ROOT))
+    {
+        stamp = 1u;
+    }
+    sNdsP2HbStampNext = stamp;
+    return stamp;
+}
+
+#define NDS_P2_HB_KEY_TRS 1u
+#define NDS_P2_HB_KEY_MTX 2u
+
+/* The inputs `cursor`'s local is built from (ndsP2HbLocal): rotate and scale
+ * bits in key[0..5] (key[6..8] zero) and translate bits in key[9..11] for a
+ * TRS local; the cached float local's rotation cells in key[0..8] and its
+ * translation row in key[9..11] for transform_update_mode. Returns the kind. */
+static u32 ndsP2HbLevelKey(u32 key[12], const DObj *cursor,
+                           const FTParts *parts)
+{
+    u32 c;
+
+    if (parts->transform_update_mode == 0)
+    {
+        key[0] = ndsP2HbBits(cursor->rotate.vec.f.x);
+        key[1] = ndsP2HbBits(cursor->rotate.vec.f.y);
+        key[2] = ndsP2HbBits(cursor->rotate.vec.f.z);
+        key[3] = ndsP2HbBits(cursor->scale.vec.f.x);
+        key[4] = ndsP2HbBits(cursor->scale.vec.f.y);
+        key[5] = ndsP2HbBits(cursor->scale.vec.f.z);
+        key[6] = 0u;
+        key[7] = 0u;
+        key[8] = 0u;
+        key[9] = ndsP2HbBits(cursor->translate.vec.f.x);
+        key[10] = ndsP2HbBits(cursor->translate.vec.f.y);
+        key[11] = ndsP2HbBits(cursor->translate.vec.f.z);
+        return NDS_P2_HB_KEY_TRS;
+    }
+    for (c = 0u; c < 3u; c++)
+    {
+        key[c] = ndsP2HbBits(parts->unk_dobjtrans_0x10[0][c]);
+        key[3u + c] = ndsP2HbBits(parts->unk_dobjtrans_0x10[1][c]);
+        key[6u + c] = ndsP2HbBits(parts->unk_dobjtrans_0x10[2][c]);
+        key[9u + c] = ndsP2HbBits(parts->unk_dobjtrans_0x10[3][c]);
+    }
+    return NDS_P2_HB_KEY_MTX;
+}
