+/* Brings `slot` to `cursor`'s world for `epoch`, from the parent world `pw`
+ * named by `pstamp` (0 = a world no stamp names); `pw` NULL is a root, whose
+ * world is its local (gmCollisionCopyMatrix). Returns 0 to decline. A slot's
+ * tag is cleared before a build writes its world, so a failed build never
+ * leaves a tag on a stale world; a carry writes nothing until it has passed.
+ * `pw` may be this very slot's world (a parent on the same slot): its
+ * translation is read before anything is written, and Compose reads lhs into
+ * a temp. */
+static int ndsP2HbLevel(NDSP2HbWorld *slot, const DObj *cursor,
+                        const FTParts *parts, const NDSR2CfxMtx *pw,
+                        u32 pstamp, u32 epoch)
+{
+    const u32 carry = gNdsP2HbCarry;
+    const u32 want = (pw == NULL) ? NDS_P2_HB_STAMP_ROOT : pstamp;
+    u32 key[12];
+    u32 kind;
+    int32_t pt[3];
+    int32_t carried_t[3];
+    /* 0 = no carry, 1 = carried, -1 = the carry declines (a guard). */
+    int carried = 0;
+    u32 c;
+
+    for (c = 0u; c < 3u; c++)
+    {
+        pt[c] = (pw != NULL) ? pw->t[c] : 0;
+    }
+    kind = ndsP2HbLevelKey(key, cursor, parts);
+    if ((carry != 0u) && (want != 0u) && (slot->dobj == cursor) &&
+        (slot->key_kind == kind) && (slot->parent_stamp == want) &&
+        (((key[0] ^ slot->key[0]) | (key[1] ^ slot->key[1]) |
+          (key[2] ^ slot->key[2]) | (key[3] ^ slot->key[3]) |
+          (key[4] ^ slot->key[4]) | (key[5] ^ slot->key[5]) |
+          (key[6] ^ slot->key[6]) | (key[7] ^ slot->key[7]) |
+          (key[8] ^ slot->key[8])) == 0u))
+    {
+        int64_t t[3];
+
+        carried = 1;
+        if (((key[9] ^ slot->key[9]) | (key[10] ^ slot->key[10]) |
+             (key[11] ^ slot->key[11])) == 0u)
+        {
+            for (c = 0u; c < 3u; c++)
+            {
+                t[c] = (int64_t)slot->world.t[c] - slot->parent_t[c] + pt[c];
+            }
+        }
+        else
+        {
+            int32_t lt[3];
+
+            /* The local's translation and its guard, as BuildLocal and
+             * LoadF32 both convert and check it. */
+            for (c = 0u; c < 3u; c++)
+            {
+                float value;
+
+                __builtin_memcpy(&value, &key[9u + c], sizeof(value));
+                lt[c] = ndsR2CollisionF32ToFixed(value, NDS_R2_CFX_POS_BITS);
+                if ((lt[c] == NDS_R2_COLLISION_F32_OVERFLOW) ||
+                    (ndsR2CfxAbs32(lt[c]) >= NDS_R2_CFX_POS_MAX))
+                {
+                    carried = -1;
+                }
+            }
+            /* Compose's translation row. */
+            for (c = 0u; (carried > 0) && (c < 3u); c++)
+            {
+                t[c] = (pw == NULL) ? (int64_t)lt[c]
+                                    : ndsR2CfxShr(
+                                          (int64_t)pw->r[0][c] * lt[0] +
+                                              (int64_t)pw->r[1][c] * lt[1] +
+                                              (int64_t)pw->r[2][c] * lt[2],
+                                          NDS_R2_CFX_ROT_BITS) +
+                                          (int64_t)pt[c];
+            }
+            gNdsP2HbCarryRows++;
+        }
+        for (c = 0u; (carried > 0) && (c < 3u); c++)
+        {
+            if ((t[c] >= (int64_t)NDS_R2_CFX_POS_MAX) ||
+                (t[c] <= -(int64_t)NDS_R2_CFX_POS_MAX))
+            {
+                carried = -1;
+            }
+            carried_t[c] = (int32_t)t[c];
+        }
+        if (carry == 1u)
+        {
+            if (carried < 0)
+            {
+                return 0;
+            }
+            for (c = 0u; c < 3u; c++)
+            {
+                slot->world.t[c] = carried_t[c];
+                slot->parent_t[c] = pt[c];
+            }
+            slot->key[9] = key[9];
+            slot->key[10] = key[10];
+            slot->key[11] = key[11];
+            slot->epoch = epoch;
+            gNdsP2HbCarries++;
+            return 1;
+        }
+    }
+    {
+        /* The full build. Under gNdsP2HbCarry 2 a carry above is checked
+         * against it: the old rotation is kept aside first. */
+        int32_t carried_r[3][3];
+        int same = 0;
+
+        if (carried > 0)
+        {
+            __builtin_memcpy(carried_r, slot->world.r, sizeof(carried_r));
+        }
+        slot->dobj = NULL;
+        if (pw == NULL)
+        {
+            if (ndsP2HbLocal(&slot->world, cursor, parts) == 0)
+            {
+                if (carried > 0)
+                {
+                    gNdsP2HbCarryMismatches++;
+                }
+                return 0;
+            }
+        }
+        else
+        {
+            NDSR2CfxMtx local;
+
+            if ((ndsP2HbLocal(&local, cursor, parts) == 0) ||
+                (ndsR2CfxCompose(&slot->world, pw, &local) == 0))
+            {
+                if (carried > 0)
+                {
+                    gNdsP2HbCarryMismatches++;
+                }
+                return 0;
+            }
+        }
+        if (carried < 0)
+        {
+            gNdsP2HbCarryMismatches++;
+        }
+        else if (carried > 0)
+        {
+            same = ((__builtin_memcmp(carried_r, slot->world.r,
+                                      sizeof(carried_r)) == 0) &&
+                    (carried_t[0] == slot->world.t[0]) &&
+                    (carried_t[1] == slot->world.t[1]) &&
+                    (carried_t[2] == slot->world.t[2])) ? 1 : 0;
+            if (same == 0)
+            {
+                gNdsP2HbCarryMismatches++;
+            }
+        }
+        slot->dobj = cursor;
+        slot->epoch = epoch;
+        if (same == 0)
+        {
+            slot->rot_stamp = ndsP2HbNewStamp();
+            slot->inv_smin_q26 = 0;
+        }
+        slot->parent_stamp = want;
+        slot->key_kind = kind;
+        for (c = 0u; c < 3u; c++)
+        {
+            slot->parent_t[c] = pt[c];
+        }
+        for (c = 0u; c < 12u; c++)
+        {
+            slot->key[c] = key[c];
+        }
+        gNdsP2HbBuilds++;
+        return 1;
+    }
+}
