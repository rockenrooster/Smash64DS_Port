+/* P2-2p8 (2026-10-05): parked lists. A slot's states outnumber its entries
+ * (Sector Z's sweep match: 80 materializations, 54 of them a key the slot
+ * had drawn before; each ~470K ticks, and 53 of the match's top 98 frames
+ * were such a frame), and the heap spare is refused wherever the battle's
+ * free bytes sit under its keep-free floor. A pool of slots outside the
+ * general heap holds evicted entries for any battle slot -- the entry state,
+ * the packet, its words (and Link's texgen site map after them) and its
+ * variant records, copied out compactly -- and a miss whose key a parked copy
+ * holds copies it back in as the victim (after parking the victim's own list)
+ * and re-bases its words: a copy of ~14 KB each way instead of a
+ * materialization. A parked copy is matched by the entry rules (tint set,
+ * texture fence, key, variant records), so a list whose textures moved is
+ * never revived. Each pool slot opens with its head (battle slot, LRU stamp,
+ * entry state), so the pool costs no BSS. The memory comes from
+ * ndsLeanParkPoolMemory (weak; NULL = no pool). Same-ROM A/B word
+ * gNdsFtrLeanParkPool (0 = the heap spare, as before); gNdsFtrLeanParkSlotBytes
+ * sizes a pool slot (0 = room for any list). */
+#define NDS_FTR_LEAN_PARK_MAX 12u
+#define NDS_FTR_LEAN_PARK_FREE 0xffu
+volatile u32 gNdsFtrLeanParkPool __attribute__((used, section(".data"))) = 1u;
+volatile u32 gNdsFtrLeanParkSlotBytes __attribute__((used, section(".data"))) =
+    0u;
+/* Lab tallies, cleaned on change: [0] revivals, [1] parks, [2] pool slots,
+ * [3] parks refused (no room in a pool slot). */
+__attribute__((used, aligned(32))) volatile u32 gNdsFtrLeanPark[8];
+
+typedef struct NDSFtrLeanParkHead
+{
+    u32 slot;                   /* battle slot, or NDS_FTR_LEAN_PARK_FREE */
+    u32 stamp;                  /* LRU: the park serial */
+    u32 list_words;             /* words copied after the packet (the floor) */
+    u32 pad;
+    NDSFtrLeanEntryState state;
+} NDSFtrLeanParkHead;
+#define NDS_FTR_LEAN_PARK_HEAD_WORDS \
+    ((((u32)sizeof(NDSFtrLeanParkHead)) + 31u) / 32u * 8u)
+
+static u32 *sNdsFtrLeanParkBase;
+static u32 sNdsFtrLeanParkSlotWords;
+static u32 sNdsFtrLeanParkCount;
+static u32 sNdsFtrLeanParkGen;  /* gNdsTaskmanHeapGeneration + 1 set up */
+static u32 sNdsFtrLeanParkStamp;
+
+/* The pool's bytes: weak, so a build with no lender has no pool. */
+__attribute__((weak)) u8 *ndsLeanParkPoolMemory(u32 *bytes)
+{
+    *bytes = 0u;
+    return NULL;
+}
+
+static inline NDSFtrLeanParkHead *ndsFtrLeanParkHeadAt(u32 i)
+{
+    return (NDSFtrLeanParkHead *)(void *)(sNdsFtrLeanParkBase +
+                                          (i * sNdsFtrLeanParkSlotWords));
+}
+
+static void ndsFtrLeanParkTally(u32 index, u32 value)
+{
+    gNdsFtrLeanPark[index] = value;
+    DC_FlushRange((const void *)gNdsFtrLeanPark, sizeof(gNdsFtrLeanPark));
+}
+
+static u32 ndsFtrLeanParkReady(void)
+{
+    if (sNdsFtrLeanParkGen != gNdsTaskmanHeapGeneration + 1u)
+    {
+        const u32 full_words =
+            NDS_FTR_LEAN_PARK_HEAD_WORDS + ndsFtrLeanHalfWords();
+        u32 slot_words = (gNdsFtrLeanParkSlotBytes + 31u) / 32u * 8u;
+        u32 bytes = 0u;
+        u8 *base = ndsLeanParkPoolMemory(&bytes);
+        u32 i;
+
+        sNdsFtrLeanParkGen = gNdsTaskmanHeapGeneration + 1u;
+        if ((slot_words == 0u) || (slot_words > full_words))
+        {
+            slot_words = full_words;
+        }
+        sNdsFtrLeanParkSlotWords = slot_words;
+        sNdsFtrLeanParkCount = 0u;
+        sNdsFtrLeanParkBase = NULL;
+        if (base != NULL)
+        {
+            const uintptr_t aligned = ((uintptr_t)base + 31u) &
+                ~(uintptr_t)31u;
+            const u32 skip = (u32)(aligned - (uintptr_t)base);
+
+            if (bytes > skip)
+            {
+                sNdsFtrLeanParkBase = (u32 *)(void *)aligned;
+                sNdsFtrLeanParkCount = (bytes - skip) / (slot_words * 4u);
+            }
+        }
+        if (sNdsFtrLeanParkCount > NDS_FTR_LEAN_PARK_MAX)
+        {
+            sNdsFtrLeanParkCount = NDS_FTR_LEAN_PARK_MAX;
+        }
+        for (i = 0u; i < sNdsFtrLeanParkCount; i++)
+        {
+            ndsFtrLeanParkHeadAt(i)->slot = NDS_FTR_LEAN_PARK_FREE;
+        }
+        ndsFtrLeanParkTally(2u, sNdsFtrLeanParkCount);
+    }
+    return (sNdsFtrLeanParkCount != 0u) ? TRUE : FALSE;
+}
+
+/* ndsFtrLeanPacketDrop's rule for the parked copies of a slot. */
+static void ndsFtrLeanParkDrop(u32 battle_slot)
+{
+    u32 i;
+
+    if (sNdsFtrLeanParkGen != gNdsTaskmanHeapGeneration + 1u)
+    {
+        return;
+    }
+    for (i = 0u; i < sNdsFtrLeanParkCount; i++)
+    {
+        NDSFtrLeanParkHead *h = ndsFtrLeanParkHeadAt(i);
+
+        if (h->slot == battle_slot)
+        {
+            h->slot = NDS_FTR_LEAN_PARK_FREE;
+        }
+    }
+}
