+/* The miss path through the pool: park the victim's valid list, and revive
+ * `key`'s parked copy as the victim when one holds it. */
+static u32 ndsFtrLeanParkTake(u32 battle_slot, u32 victim, const u32 *key)
+{
+    NDSFtrLeanSlotState *s = &sNdsFtrLeanSlots[battle_slot];
+    NDSFtrLeanEntryState *ves = &s->entry[victim];
+    const u32 fence = ndsFtrLeanFenceNow();
+    NDSFtrLeanParkHead *found = NULL;
+    u32 found_bits = 0u;
+    u32 i;
+
+    for (i = 0u; i < sNdsFtrLeanParkCount; i++)
+    {
+        NDSFtrLeanParkHead *h = ndsFtrLeanParkHeadAt(i);
+
+        if (h->slot == battle_slot)
+        {
+            const u32 bits = ndsFtrLeanParkMatch(h, key, fence);
+
+            if (bits != NDS_FTR_LEAN_ENTRY_NONE)
+            {
+                found = h;
+                found_bits = bits;
+                break;
+            }
+        }
+    }
+    if ((ves->valid != 0u) && ((ves->valid & NDS_FTR_LEAN_VALID_WIDE) == 0u))
+    {
+        const u32 *src = ndsFtrLeanEntryBase(battle_slot, victim);
+        const u32 floor = ndsFtrLeanParkFloor(ves,
+            (const NDSFighterPacket *)(const void *)src);
+        const u32 records = ves->variant_count * NDS_FTR_LEAN_VARIANT_WORDS;
+        NDSFtrLeanParkHead *park = NULL;
+
+        if (((floor + records) <= ndsFtrLeanWordCapacity()) &&
+            ((NDS_FTR_LEAN_PARK_HEAD_WORDS + NDS_FTR_LEAN_STRUCT_WORDS +
+              floor + records) <= sNdsFtrLeanParkSlotWords))
+        {
+            /* A free slot, else the least recently parked copy (never the
+             * one about to be revived). */
+            for (i = 0u; i < sNdsFtrLeanParkCount; i++)
+            {
+                NDSFtrLeanParkHead *h = ndsFtrLeanParkHeadAt(i);
+
+                if (h == found)
+                {
+                    continue;
+                }
+                if (h->slot == NDS_FTR_LEAN_PARK_FREE)
+                {
+                    park = h;
+                    break;
+                }
+                if ((park == NULL) || ((s32)(h->stamp - park->stamp) < 0))
+                {
+                    park = h;
+                }
+            }
+        }
+        else
+        {
+            ndsFtrLeanParkTally(3u, gNdsFtrLeanPark[3] + 1u);
+        }
+        if (park != NULL)
+        {
+            u32 *dst = (u32 *)(void *)park + NDS_FTR_LEAN_PARK_HEAD_WORDS;
+
+            memcpy(dst, src,
+                   (NDS_FTR_LEAN_STRUCT_WORDS + floor) * sizeof(u32));
+            if (records != 0u)
+            {
+                memcpy(dst + NDS_FTR_LEAN_STRUCT_WORDS + floor,
+                       src + NDS_FTR_LEAN_STRUCT_WORDS +
+                           ndsFtrLeanWordCapacity() - records,
+                       records * sizeof(u32));
+            }
+            park->state = *ves;
+            park->list_words = floor;
+            park->slot = battle_slot;
+            park->stamp = ++sNdsFtrLeanParkStamp;
+            ndsFtrLeanParkTally(1u, gNdsFtrLeanPark[1] + 1u);
+        }
+    }
+    ves->valid = 0u;
+    if (s->active == victim)
+    {
+        s->active = NDS_FTR_LEAN_ENTRY_NONE;
+    }
+    if (found == NULL)
+    {
+        return NDS_FTR_LEAN_ENTRY_NONE;
+    }
+    {
+        u32 *dst = ndsFtrLeanEntryBase(battle_slot, victim);
+        const u32 *src = (const u32 *)(const void *)found +
+            NDS_FTR_LEAN_PARK_HEAD_WORDS;
+        const u32 floor = found->list_words;
+        const u32 records =
+            found->state.variant_count * NDS_FTR_LEAN_VARIANT_WORDS;
+        NDSFighterPacket *packet;
+
+        /* Nothing may still be streaming the victim's old words. */
+        ndsFighterPacketDmaWait();
+        memcpy(dst, src, (NDS_FTR_LEAN_STRUCT_WORDS + floor) * sizeof(u32));
+        if (records != 0u)
+        {
+            memcpy(dst + NDS_FTR_LEAN_STRUCT_WORDS + ndsFtrLeanWordCapacity() -
+                       records,
+                   src + NDS_FTR_LEAN_STRUCT_WORDS + floor,
+                   records * sizeof(u32));
+        }
+        *ves = found->state;
+        memset(ves->dirty, 0, sizeof(ves->dirty));
+        packet = (NDSFighterPacket *)(void *)dst;
+        packet->words = dst + NDS_FTR_LEAN_STRUCT_WORDS;
+        /* The DMA reads the words from memory: clean them, as a fresh
+         * materialization does. */
+        DC_FlushRange(packet->words, packet->word_count * sizeof(u32));
+        found->slot = NDS_FTR_LEAN_PARK_FREE;
+        ndsFtrLeanParkTally(0u, gNdsFtrLeanPark[0] + 1u);
+        return victim | found_bits;
+    }
+}
