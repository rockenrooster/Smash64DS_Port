--- a/src/nds/nds_audio_fgm.c
+++ b/src/nds/nds_audio_fgm.c
@@ -227,6 +227,23 @@ static u32 sNdsAudioFgmFillPartsInFlight;
 /* Lab sizing word (boot poke): the arena bytes actually used, <= the array. */
 __attribute__((used)) volatile u32 gNdsAudioFgmArenaLimit =
     NDS_AUDIO_FGM_CACHE_BYTES;
+/* P2-2p8 (2026-10-05): the arena tail a lowered gNdsAudioFgmArenaLimit leaves
+ * unused (no fill places past the limit, ndsAudioFgmArenaPlace), lent to the
+ * lean parked-list pool (src/nds/nds_renderer_native_common.c). */
+u8 *ndsLeanParkPoolMemory(u32 *bytes)
+{
+    u32 limit = gNdsAudioFgmArenaLimit;
+
+    limit = (limit + 31u) & ~31u;
+    if (limit >= NDS_AUDIO_FGM_CACHE_BYTES)
+    {
+        *bytes = 0u;
+        return NULL;
+    }
+    *bytes = NDS_AUDIO_FGM_CACHE_BYTES - limit;
+    return &sNdsAudioFgmCache[limit];
+}
