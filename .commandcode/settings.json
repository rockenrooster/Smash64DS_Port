      "Edit(.commandcode/settings.json)",
      "Edit(.git/**)",
      "Shell(make:*)",
      "Shell(mingw32-make:*)",
      "Shell(pwsh:*)",
      "Shell(pwsh.exe:*)",
      "Shell(powershell:*)",
      "Shell(powershell.exe:*)",
      "Shell(melonDS:*)",
      "Shell(arm-none-eabi-gdb:*)",
      "Shell(git commit:*)",
      "Shell(git push:*)",
      "Shell(git reset:*)",
      "Shell(git rebase:*)",
      "Shell(git checkout:*)",
      "Shell(git restore:*)",
      "Shell(git clean:*)",
      "Shell(git stash:*)",
      "Shell(git branch:*)",
      "Shell(git merge:*)",
      "Shell(git cherry-pick:*)",
      "Shell(git filter-branch:*)",
      "Shell(npm install:*)",
      "Shell(pip install:*)",
      "Shell(sudo:*)",
      "Shell(curl:*)",
      "Shell(wget:*)",
