      "Shell(git blame:*)",
      "Shell(git ls-files:*)",
      "Shell(rg:*)",
      "Shell(python:*)",
      "Shell(python3:*)",
      "Shell(py:*)",
      "Shell(arm-none-eabi-nm:*)",
      "Shell(arm-none-eabi-size:*)",
      "Shell(arm-none-eabi-objdump:*)"
    ]
