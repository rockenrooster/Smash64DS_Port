{
  "permissions": {
    "defaultMode": "default",
    "deny": [
      "Edit(decomp/**)",
      "Edit(AGENTS.md)",
      "Edit(CLAUDE.md)",
      "Edit(AGENTS.OPUS.md)",
      "Edit(CLAUDE.OPUS.md)",
      "Edit(PROJECT_GOAL.md)",
