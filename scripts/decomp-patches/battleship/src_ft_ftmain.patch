--- a/src/ft/ftmain.c
+++ b/src/ft/ftmain.c
@@ -4620,8 +4620,46 @@
         }
         else if (motion_desc->anim_file_id != 0)
         {
+#if defined(SSB64_TARGET_NDS)
+            /* THE RETURNED POINTER IS AUTHORITATIVE ON DS.
+             *
+             * The N64 line below discards the return value and hardcodes the
+             * fighter's own heap, which forces the DS backend to physically
+             * place the animation bytes there -- i.e. to copy them -- even when
+             * it already holds an identical, immutable image. That is the
+             * second of the two reasons the adapter copies (the first is the
+             * absolute-pointer fixups), and it is the one a build-time
+             * BattlePack cannot touch, because it lives in this body rather
+             * than in the port: src/import/battleship_ftmain.c #includes this
+             * file and wraps only the entry point.
+             *
+             * INERT TODAY, and that is provable rather than hoped:
+             * lbRelocGetForceExternHeapFile (src/port/reloc_backend_assets.c)
+             * returns exactly `heap` on every path when heap != NULL --
+             *   - the Mario/Fox arm is `(file != NULL) ? file : heap` over
+             *     ndsRelocForceLoadFighterAObj16File, whose only returns are
+             *     `heap` and NULL;
+             *   - the generic arm returns `heap` on every early exit, and on
+             *     success returns loaded->data, which the wrapper then copies
+             *     into heap and rewrites to `heap` -- ndsRelocFindLoadedFileByData
+             *     cannot miss, because every non-NULL loaded file it could have
+             *     come from is an element of sNdsRelocLoadedFiles[]
+             * -- and returns NULL only when heap itself is NULL, which is the
+             * same value the N64 line stores. So this assignment reproduces
+             * `fp->figatree = fp->figatree_heap` value-for-value until a
+             * const-clip path deliberately returns other storage.
+             *
+             * Safe to let a non-heap pointer through: fp->figatree is read at
+             * :4628 (a NULL test) and :4704 only, nothing in the tree assumes
+             * it equals figatree_heap, and the port's
+             * lbCommonAddFighterPartsFigatree already resolves every entry
+             * against the base pointer it is handed
+             * (ndsRelocResolvePointerFromFileBase, reloc_backend_compat_shims.c). */
+            fp->figatree = lbRelocGetForceExternHeapFile(motion_desc->anim_file_id, (void*) fp->figatree_heap);
+#else
             lbRelocGetForceExternHeapFile(motion_desc->anim_file_id, (void*) fp->figatree_heap);
             fp->figatree = fp->figatree_heap;
+#endif
         }
         else fp->figatree = NULL;
         
