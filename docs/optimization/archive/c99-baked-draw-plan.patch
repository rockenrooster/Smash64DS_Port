+            {
+                workspace->material_counts[i] = material_count;
+                *out_owner_file = owner_file;
+                return nNDSFighterDrawPlanMaterialCount;
+            }
+        }
+        workspace->material_counts[i] = material_count;
+    }
+    *out_owner_file = owner_file;
+    return nNDSFighterDrawPlanOk;
