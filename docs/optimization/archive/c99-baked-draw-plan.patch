+typedef struct NDSFighterDrawPlan
+{
+    NDSFighterDrawPlanData data;
+    const void *key_data;
+    u32 key_asset_id;
+    u32 key_owner_generation;
+    u32 key_data_size;
+    u32 valid;
+} NDSFighterDrawPlan;
