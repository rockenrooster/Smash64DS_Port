Subject: [CANDIDATE; NOT ROM VERIFIED] DATA: source-art surfaces for locked and unlocked layouts\nBase-commit: a5c5bc08d8e8661658865216798d600462db948e\nClassification: IMPLEMENTATION CANDIDATE / producer + runtime; asset regeneration required\nOwner-issues: 4\nReplaces the retired text-slab consumer with the same native surface API as\nOptions. Adds source DATA background and ten row-state surfaces at the END of\nthe generated surface list, preserving prior IDs. Keeps unlock policy and scene\nrouting unchanged. Assets/O2R are unavailable here: regenerate on the prepared\ncheckout and verify dependency/staging, bounds, memory, natural pixels and\ncadence. DATA children (VS Record/Sound Test) remain separate unclosed work.\n\ndiff --git a/scripts/menus/generate_mn_ui_kit.py b/scripts/menus/generate_mn_ui_kit.py\n--- a/scripts/menus/generate_mn_ui_kit.py\n+++ b/scripts/menus/generate_mn_ui_kit.py\n@@ -4205 +4205,62 @@\n+# Native DATA: source mn/mndata/mndata.c; append after existing surfaces.\n+# The source uses a 16*8 middle strip, not Options' 17*8 strip. Two-row and\n+# three-row layouts have different positions; unlocking changes layout only.\n+DATA_BACKGROUND = (\n+    COLLAGE_FULL_BLEED,\n+    Placement("MNCommon", "llMNCommonDecalPaperSprite", 140, 143, False,\n+              (0xA0, 0x78, 0x14)),\n+    Placement("MNCommon", "llMNCommonDecalPaperSprite", 225, 56, False,\n+              (0xA0, 0x78, 0x14)),\n+    Placement("MNData", "llMNDataDataIconDarkSprite", 10, 10, False,\n+              (0x99, 0x99, 0x99)),\n+    Placement("MNData", "", 225, 143, False,\n+              fill=(0xA0, 0x78, 0x14, 0xE6), size=(85, 87)),\n+    Placement("MNCommon", "llMNCommonSmashLogoSprite", 235, 158, False,\n+              (0x00, 0x00, 0x00)),\n+    Placement("MNData", "llMNDataDataTextSprite", 206, 131, False,\n+              (0x00, 0x00, 0x00)),\n+)\n+\n+\n+def data_row_surface(layout: str, row: str, x: int, y: int,\n+                     text_dx: int, hi: bool) -> SurfaceSpec:\n+    """Source tab and label, including background under the dirty rectangle."""\n+    env, prim = OPTION_TAB_HI if hi else OPTION_TAB_NOT\n+    symbol = {\n+        "CHARACTERS": "llMNDataCharactersTextSprite",\n+        "VS_RECORD": "llMNDataVSRecordTextSprite",\n+        "SOUND_TEST": "llMNDataSoundTestTextSprite",\n+    }[row]\n+    parts = (\n+        Placement("MNCommon", "llMNCommonOptionTabLeftSprite", x, y,\n+                  False, prim, env=env),\n+        Placement("MNCommon", "llMNCommonOptionTabMiddleSprite", x + 16, y,\n+                  False, prim, env=env, tile=(16 * 8, 29), period=(16, None)),\n+        Placement("MNCommon", "llMNCommonOptionTabRightSprite", x + 144, y,\n+                  False, prim, env=env),\n+        Placement("MNData", symbol, x + text_dx, y + 4, False,\n+                  (0x00, 0x00, 0x00)),\n+    )\n+    token = f"DATA_{layout}_{row}" + ("_HI" if hi else "")\n+    # Options reserves 172 columns for a 17*8 middle. DATA's 16*8 middle\n+    # requires eight fewer. Includes the same right cap without truncation.\n+    return SurfaceSpec(token, parts, MENU_FIELD, under=DATA_BACKGROUND,\n+                       box=(x, y, 164, 29))\n+\n+\n+DATA_SURFACE_SPECS = (\n+    SurfaceSpec("DATA", DATA_BACKGROUND, MENU_FIELD),\n+    *(data_row_surface(layout, row, x, y, dx, hi)\n+      for layout, rows in (\n+          ("LOCKED", (("CHARACTERS", 113, 57, 26),\n+                      ("VS_RECORD", 81, 126, 27))),\n+          ("UNLOCKED", (("CHARACTERS", 133, 42, 26),\n+                        ("VS_RECORD", 101, 89, 27),\n+                        ("SOUND_TEST", 69, 136, 26))),\n+      )\n+      for row, x, y, dx in rows\n+      for hi in (False, True)),\n+)\n+\n+\n def main(argv: list[str] | None = None) -> int:\n@@ -4300,4 +4361,7 @@\n     # Native Character Data art is appended last so existing ids stay stable.\n     surfaces.extend(convert_surface(cache, offsets, repo_root, spec)\n                     for spec in CHARACTERS_SURFACE_SPECS)\n+    # Append DATA without renumbering any existing surface.\n+    surfaces.extend(convert_surface(cache, offsets, repo_root, spec)\n+                    for spec in DATA_SURFACE_SPECS)\n     check_title_anim_block(surfaces)\ndiff --git a/scripts/menus/audit_mn_screen_coverage.py b/scripts/menus/audit_mn_screen_coverage.py\n--- a/scripts/menus/audit_mn_screen_coverage.py\n+++ b/scripts/menus/audit_mn_screen_coverage.py\n@@ -520,5 +520,5 @@\n     for table in ("ITEM_SWITCH_SURFACE_SPECS", "VS_OPTIONS_SURFACE_SPECS",\n                   "OPTION_SURFACE_SPECS", "BACKUP_CLEAR_SURFACE_SPECS",\n-                  "CHARACTERS_SURFACE_SPECS"):\n+                  "CHARACTERS_SURFACE_SPECS", "DATA_SURFACE_SPECS"):\n         for spec in getattr(module, table, ()):\n             target = out.setdefault(f"SURFACE_{spec.token}", set())\ndiff --git a/src/nds/nds_menu_shell_data.c b/src/nds/nds_menu_shell_data.c\n--- a/src/nds/nds_menu_shell_data.c\n+++ b/src/nds/nds_menu_shell_data.c\n@@ -33,18 +33,7 @@\n- * PRESENTATION. The source marks the cursor row with the tab HIGHLIGHT\n- * pair (ENV 82/00/28 PRIM FF/00/28) and the rest NOT (ENV 00/00/00 PRIM\n- * 82/82/AA) (mnDataSetOptionSpriteColors :131-177). The converted UI ki\n- * carries no DATA art yet, so the rows are the kit's own font text in\n- * those two primitive colours on the shell's shared blue field, in the\n- * VS-menu cascade the other row screens use.\n- *\n- * TODO(DATA-KIT): bake the DATA sprites and replace the font rows --\n- * llMNDataDataTextSprite (header), llMNDataCharactersTextSprite,\n- * llMNDataVSRecordTextSprite, llMNDataSoundTestTextSprite (rows),\n- * llMNDataDataIconDarkSprite (entry icon),\n- * llMNCommonSmashBrosCollageSprite + llMNCommonDecalPaperSprite\n- * (backdrop), llMNCommonSmashLogoSprite (emblem) and the\n- * llMNCommonOptionTabLeft/Middle/RightSprite tabs -- following the\n- * Option screen's row-surface shape (nds_menu_shell_option.c).\n+ * PRESENTATION. Build-time DATA surface