# Build products
/build/
/build-*/
/builds/
# A lab build that landed at the repo root instead of under builds/. 11 MB of
# objects plus a copy of the gitignored /assets/ nitrofs tree, so it must not be
# tracked; the standing rule is that all lab outputs stay in builds/.
/nocull2/
*.nds
*.elf
*.map
*.sym
*.ds.gba
/_*.gdb*

# Generated by build.ps1
/BattleShip_o2r/
/assets/
# ROM-derived exports inside the decomp reference tree: the fetch script
# rebuilds BattleShip from upstream but explicitly does NOT restore these
# ("cannot be redistributed"). They exist locally only because the owner ran
# the O2R export and asset extraction here.
/decomp/BattleShip-main/BattleShip_o2r/
/decomp/BattleShip-main/decomp/BattleShip_o2r/
/decomp/BattleShip-main/decomp/assets/
# Cargo build output inside the decomp reference tree. These blobs bake the
# absolute `C:\Users\<user>\.cargo\...` and `...\.rustup\...` paths of whichever
# machine ran `cargo build`, so they carry the owner's given name into tracked
# files and CLAUDE.md forbids that. Untracked 2026-08-13 on the owner's decision
# (`artifacts/performance/2026-08-13_c-residue/OWNER_DECISIONS.md` §9, option
# "scrub the 16 files"); the remaining ~26,260 files under /decomp/ stay tracked
# by that same decision. The blobs stay ON DISK -- /decomp/ is read-only
# reference, vpk0cmd.exe is a usable tool there, and cargo regenerates the rest.
/decomp/BattleShip-main/decomp/tools/vpk0cmd.exe
/decomp/BattleShip-main/decomp/tools/vpk0_build/target/.rustc_info.json
/decomp/BattleShip-main/decomp/tools/vpk0_build/target/release/deps/
/decomp/BattleShip-main/decomp/tools/vpk0_build/target/release/vpk0cmd.exe
/decomp/BattleShip-main/decomp/tools/vpk0_build/target/release/vpk0cmd.pdb
/src/nds/generated/
/src/nds/nds_native_fighter_owner.generated.inc
/src/nds/nds_native_stage_owner.generated.inc
/src/nds/nds_native_stage_yoster.generated.inc

# Lab / dev-only
/artifacts/
/logs/
/.tura/
/.zcode/
/.freebuff
# The skill trees are shared project assets and must survive a fresh clone or a
# new worktree; everything else under these directories is local state. A plain
# `/.agents/` exclusion cannot be re-included per-path, so exclude the contents.
/.agents/*
!/.agents/skills/
/.claude/*
!/.claude/skills/
/prompts/
/sessions/

# Emulator
/melonDS.toml
/melonds.*.log
/rtc.bin
/emulators/*
!/emulators/README.md

# Python
__pycache__/
*.pyc
worktree_report.md
# Local pre-change backups (project CLAUDE.md convention) stay on disk only.
backups/
